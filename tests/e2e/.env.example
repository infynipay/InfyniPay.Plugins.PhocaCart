# =============================================================================
# Infynipay PhocaCart — E2E environment configuration
# Copy this file to `.env` and fill in the values for YOUR local server.
# `.env` is git-ignored so your credentials never get committed.
# =============================================================================

# --- Joomla site ------------------------------------------------------------
# Frontend root of your local Joomla install (no trailing slash).
JOOMLA_BASE_URL=http://localhost/joomla
# Administrator URL. Defaults to JOOMLA_BASE_URL + /administrator if left blank.
JOOMLA_ADMIN_URL=
# Super User credentials used to install the plugin and run setup.
JOOMLA_ADMIN_USER=admin
JOOMLA_ADMIN_PASSWORD=change-me

# --- Plugin package ---------------------------------------------------------
# Absolute or relative path to the installable plugin .zip.
# Run `npm run build:zip` to generate it at the default location below.
PLUGIN_ZIP=./dist/plg_pcp_infynipay.zip

# --- Infynipay console (real OAuth sign-in) -------------------------------
# Sandbox account used to complete the "Connect" / grant-authorization flow
# at https://console.infynipay.com
PH_CONSOLE_EMAIL=you@example.com
PH_CONSOLE_PASSWORD=change-me

# --- PhocaCart shop ---------------------------------------------------------
# Direct URL of a published test product detail page (the test adds it to cart).
TEST_PRODUCT_URL=http://localhost/joomla/index.php?option=com_phocacart&view=item&id=1
# Title of the PhocaCart payment method that uses the Infynipay plugin
# (must be created & published in PhocaCart > Payment Methods, alias "infynipay").
PAYMENT_METHOD_NAME=Infynipay
# Title of any published shipping method to pick during checkout.
SHIPPING_METHOD_NAME=

# --- Test customer (checkout billing details) -------------------------------
TEST_CUSTOMER_FIRST_NAME=Test
TEST_CUSTOMER_LAST_NAME=Buyer
TEST_CUSTOMER_EMAIL=test.buyer@example.com
TEST_CUSTOMER_ADDRESS=221B Baker Street
TEST_CUSTOMER_CITY=London
TEST_CUSTOMER_ZIP=NW16XE
TEST_CUSTOMER_PHONE=+15555550123
# Country as shown in the PhocaCart country dropdown.
TEST_CUSTOMER_COUNTRY=United Kingdom

# --- Infynipay sandbox hosted page (test card) ----------------------------
# Test card details used to approve the payment on the sandbox hosted page.
# Use the sandbox test card published in your Infynipay console docs.
SANDBOX_CARD_NUMBER=4111111111111111
SANDBOX_CARD_EXP=12/30
SANDBOX_CARD_CVC=123
SANDBOX_CARD_NAME=Test Buyer

# --- Tuning -----------------------------------------------------------------
# Max ms to wait for the sandbox payment + redirect back to the shop.
PAYMENT_TIMEOUT_MS=120000

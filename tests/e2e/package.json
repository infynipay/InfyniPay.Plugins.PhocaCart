{
  "name": "infynipay-phocacart-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end tests for the Infynipay PhocaCart payment plugin",
  "type": "module",
  "scripts": {
    "build:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-plugin-zip.ps1",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5"
  }
}
